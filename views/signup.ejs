<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" type="text/css" href="/style.css" />
    <title>Sign Up</title>
  </head>
  <body>
    <h1><a href="/">Club</a></h1>
    <h2>Create an Account</h2>
    <form action="/signup" method="POST">
      <div class="form-control">
        <p><label for="firstname">First Name:</label></p>
        <p>
          <input
            type="text"
            name="firstname"
            id="firstname"
            value="<%= userInfo.firstname || '' %>"
          />
        </p>
      </div>
      <div class="form-control">
        <p><label for="lastname">Last Name:</label></p>
        <p>
          <input
            type="text"
            name="lastname"
            id="lastname"
            value="<%= userInfo.lastname || '' %>"
          />
        </p>
      </div>
      <div class="form-control">
        <p><label for="email">E-mail:</label></p>
        <p>
          <input
            type="email"
            name="email"
            id="email"
            value="<%= userInfo.email || '' %>"
          />
        </p>
      </div>
      <div class="form-control">
        <p><label for="password">Password</label></p>
        <p>
          <input
            type="password"
            name="password"
            id="password"
            value="<%= userInfo.password || '' %>"
          />
        </p>
      </div>
      <fieldset class="form-control">
        <legend>Do you want to become a member?</legend>
        <p>
          <input type="radio" name="member" id="member1" value="true" checked />
          <label for="member1"
            >Yes, you can view posts and their author at the same time.</label
          >
        </p>
        <p>
          <input type="radio" name="member" id="member2" value="false" />
          <label for="member2"
            >No, you can only see posts, authors of posts will stay
            anonymous</label
          >
        </p>
      </fieldset>
      <p><button type="submit">Submit</button></p>
    </form>
    <% if(errors) {%>
    <ul>
      <% errors.forEach(error => { %>
      <li class="error"><%= error.msg %></li>
      <% }); %>
    </ul>
    <% } %>
  </body>
</html>
