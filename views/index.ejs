<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members</title>
  </head>
  <body>
    <% if (locals.user) {%>
    <h1>Welcome back <%= user.username %></h1>
    <a href="/logout">Log Out</a>
    <% } else {%>
    <h1>Welcome to the Club!</h1>
    <p>
      Please <a href="/login">log in</a> first, if you don't have an account,
      please click <a href="/signup">here</a> to create one.
    </p>
    <% } %>
    <h3>This page has been viewed <%- views %> times</h3>
  </body>
</html>
