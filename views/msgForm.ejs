<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" type="text/css" href="/style.css" />
    <title>Club</title>
  </head>
  <body>
    <h1><a href="/">Club</a></h1>
    <h2>Make a Post</h2>
    <form action="/add-msg" method="post">
      <div class="form-control">
        <p>
          <label for="title">Title:</label>
        </p>
        <p>
          <input type="text" name="title" id="title" value="<%= msgInfo.title ||
          "" %>"/>
        </p>
      </div>
      <div class="form-control">
        <p>
          <label for="msg">Content:</label>
        </p>
        <p>
          <textarea name="msg" id="msg" rows="5" cols="33">
<%= msgInfo.msg || "" %></textarea
          >
        </p>
      </div>
      <button type="submit">Submit</button>
    </form>
    <% if(errors) {%>
    <ul>
      <% errors.forEach(error => { %>
      <li class="error"><%= error.msg %></li>
      <% }); %>
    </ul>
    <% } %>
  </body>
</html>
